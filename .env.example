PORT=5174

# Local demo mode: API returns success and prints emails to console.
MAIL_DEV_MODE=true

# Real email delivery for production.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=user@example.com
SMTP_PASS=change-me
MAIL_FROM="Руслан Тимергалиев <user@example.com>"
OWNER_EMAIL=owner@example.com

# Optional AI helper. Without this key the backend returns a deterministic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
